---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const { site } = config;

// Ambil semua artikel
const posts = await getCollection("posts");

// Filter artikel: bukan draft dan tanggal terbit sudah lewat/hari ini
const now = new Date();
const publishedPosts = posts.filter(
  ({ data }) => !data.draft && new Date(data.pubDatetime) <= now
);

// Urutkan artikel pilihan (featured) terlebih dahulu
const featuredPosts = publishedPosts
  .filter(({ data }) => data.featured)
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  );

const nonFeaturedPosts = publishedPosts
  .filter(({ data }) => !data.featured)
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  );

// Gabungkan dan ambil Top 10
const popularPosts = [...featuredPosts, ...nonFeaturedPosts].slice(0, 10);
---

<Layout title={`Popular Expeditions | ${site.title}`}>
  <Header />

  <main id="main-content" class="app-layout mx-auto w-full max-w-4xl py-8">
    <header class="border-b border-border/70 pb-6">
      <span class="text-xs font-bold uppercase tracking-widest text-accent">Curated Field Guides</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-foreground mt-1">
        Popular Expeditions
      </h1>
      <p class="mt-2 text-foreground/75 text-sm sm:text-base leading-relaxed">
        The most read and historically compelling dark expeditions documented across the ShadowAtlas archives.
      </p>
    </header>

    <section class="mt-8 space-y-5">
      {
        popularPosts.length > 0 ? (
          popularPosts.map((post, index) => {
            const postSlug = post.slug ?? post.id.replace(/\.md$/, "");
            const rank = String(index + 1).padStart(2, "0");

            return (
              <article class="group relative flex flex-col sm:flex-row items-start gap-4 p-5 rounded-2xl border border-border/60 bg-background/50 hover:bg-muted/40 transition-all duration-300 hover:border-accent/60 hover:shadow-md">
                <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-xl bg-accent/10 border border-accent/20 text-accent font-mono font-bold text-xl sm:text-2xl group-hover:scale-105 group-hover:bg-accent group-hover:text-background transition-all">
                  #{rank}
                </div>

                <div class="flex-1">
                  <div class="flex items-center gap-2 text-xs text-foreground/50 mb-1 font-mono">
                    <time datetime={post.data.pubDatetime.toISOString()}>
                      {new Date(post.data.pubDatetime).toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                    {post.data.featured && (
                      <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-accent/15 text-accent">
                        ★ Must-Read
                      </span>
                    )}
                  </div>

                  <h2 class="text-lg sm:text-xl font-bold text-foreground group-hover:text-accent transition-colors leading-snug">
                    <a href={`/posts/${postSlug}/`} class="focus:outline-none">
                      <span class="absolute inset-0" aria-hidden="true" />
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="mt-2 text-xs sm:text-sm text-foreground/70 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>

                  <div class="mt-3 flex flex-wrap gap-1.5 z-10 relative">
                    {post.data.tags?.slice(0, 3).map((tag: string) => (
                      <span class="text-[11px] font-mono text-foreground/60 bg-muted/60 px-2 py-0.5 rounded">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>
              </article>
            );
          })
        ) : (
          <div class="text-center py-16 text-foreground/60">
            <p>No published expeditions available yet.</p>
          </div>
        )
      }
    </section>
  </main>

  <Footer />
</Layout>
